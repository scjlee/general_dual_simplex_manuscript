#!/usr/bin/env bash
# Reject deletion or non-fast-forward (force) pushes to protected branches.
# Stands in for GitHub branch protection. Bypassable only with --no-verify.

PROTECTED="main"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    branch="${remote_ref#refs/heads/}"
    [[ " $PROTECTED " == *" $branch "* ]] || continue

    if [[ "$local_sha" == "$ZERO" ]]; then
        echo "pre-push: refusing to delete protected branch '$branch'." >&2
        status=1
    elif [[ "$remote_sha" != "$ZERO" ]] &&
         ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: refusing non-fast-forward push to '$branch'." >&2
        echo "          Remote tip $remote_sha is not in your history. Fetch and merge instead." >&2
        status=1
    fi
done

exit $status
